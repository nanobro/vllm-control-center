# Optional local dev overrides
BACKEND_PORT=8787
FRONTEND_PORT=5173
VITE_API_BASE=http://127.0.0.1:8787

# Optional Hugging Face token for private/gated models. Do not commit real tokens.
HF_TOKEN=

# Optional controller protection. When set, all /api routes except /api/health
# require Authorization: Bearer <key> or X-VCC-API-Key: <key>.
VCC_CONTROLLER_API_KEY=

# Keep false unless you explicitly want local browser dev to skip auth.
VCC_ALLOW_LOCALHOST_AUTH_BYPASS=false

# Optional frontend default API key for local dev. Prefer browser Settings for normal use.
VITE_VCC_API_KEY=

# Secret storage backend. v15 keeps sqlite active; keyring is a research/prototype path.
VCC_SECRET_BACKEND=sqlite
VCC_SECRET_SERVICE_NAME=vllm-control-center

# Development-only escape hatch for the generic remote forwarding endpoint.
# Keep false for normal use; dedicated remote bridge routes should be preferred.
VCC_ALLOW_REMOTE_FORWARDING=false
